#include <iostream>
#include <fstream>
#include <string>

// A C++ struct to group Memory Metrics together
struct MemoryStats {
    uint64_t total_kb = 0;
    uint64_t free_kb = 0;
    uint64_t available_kb = 0;
    double used_percent = 0.0;
};

// Function to read and parse /proc/meminfo
MemoryStats getMemoryStats() {
    MemoryStats mem;
    std::ifstream file("/proc/meminfo");
    
    if (!file.is_open()) {
        std::cerr << "Warning: Could not open /proc/meminfo\n";
        return mem;
    }

    std::string key;
    uint64_t value;
    std::string unit;

    // Loop through /proc/meminfo line by line
    while (file >> key >> value >> unit) {
        if (key == "MemTotal:") {
            mem.total_kb = value;
        } else if (key == "MemFree:") {
            mem.free_kb = value;
        } else if (key == "MemAvailable:") {
            mem.available_kb = value;
        }
    }

    if (mem.total_kb > 0) {
        uint64_t used_kb = mem.total_kb - mem.available_kb;
        mem.used_percent = (static_cast<double>(used_kb) / mem.total_kb) * 100.0;
    }

    return mem;
}

int main() {
    // 1. Read CPU Load
    std::ifstream loadavg_file("/proc/loadavg");
    double load1m = 0.0, load5m = 0.0, load15m = 0.0;
    if (loadavg_file.is_open()) {
        loadavg_file >> load1m >> load5m >> load15m;
    }

    // 2. Read Memory Stats
    MemoryStats mem = getMemoryStats();

    // 3. Print Report
    std::cout << "=======================================\n";
    std::cout << "     Linux Host Inspector (v1.1)       \n";
    std::cout << "=======================================\n";
    std::cout << "[+] CPU Load (1m / 5m / 15m):\n";
    std::cout << "    " << load1m << " / " << load5m << " / " << load15m << "\n\n";

    std::cout << "[+] Memory Usage:\n";
    std::cout << "    Total     : " << (mem.total_kb / 1024.0 / 1024.0) << " GB\n";
    std::cout << "    Available : " << (mem.available_kb / 1024.0 / 1024.0) << " GB\n";
    std::cout << "    Used      : " << mem.used_percent << " %\n";
    std::cout << "=======================================\n";

    return 0;
}
